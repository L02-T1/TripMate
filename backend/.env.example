# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tripmate
# Production example:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/tripmate?retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=tripmate_dev_secret_change_me_in_production
JWT_EXPIRES_IN=30d

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Leave empty or set * to allow all origins (fine for development)
# For production: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=*
